<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_audio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@drawable/ui_scroll_thumb"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- 卡片：音量与电台 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_audio_001"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/ui_settings_panel_audio_002"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 游戏音效音量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_4sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_003"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_004"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_sfx_volume"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_sfx_volume_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="80%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 音乐与电台音量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_005"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_006"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_music_volume"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_music_volume_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="80%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 默认车载电台 (FEA_RSS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_007"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_008"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_radio_station"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 车载电台自动调频 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_009"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_010"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_radio_autotune"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片：联机语音 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_audio_011"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_012"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_013"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/voice_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 语音接收音量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_014"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_015"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_voice_volume"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_voice_volume_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="100%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 启用麦克风发言 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_016"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_017"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_voice_mic_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 麦克风输入增益 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_018"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_019"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_voice_mic_volume"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_voice_mic_volume_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="75%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 麦克风操作触发方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_020"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_021"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_voice_mic_mode"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 麦克风按钮大小 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_022"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_023"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_voice_btn_size"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="50"
                    android:valueTo="150" />

                <TextView
                    android:id="@+id/tv_voice_btn_size_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="100%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 显示正在说话玩家列表 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_024"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_025"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_voice_speaker_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 语音自动音量均衡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_026"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_027"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_voice_balancer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 环境噪音过滤 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_audio_028"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_audio_029"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_voice_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
