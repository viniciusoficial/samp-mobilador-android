<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_multiplayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@drawable/ui_scroll_thumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- 卡片：角色与服务器兼容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_multiplayer_001"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:text="@string/ui_settings_panel_multiplayer_002"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 默认游戏昵称 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_multiplayer_003"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_004"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_settings_nickname"
                    android:layout_width="@dimen/_125sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:background="@drawable/launcher_input_bg"
                    android:gravity="center_vertical"
                    android:hint="@string/ui_settings_panel_multiplayer_005"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLength="24"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:singleLine="true"
                    android:textColor="@color/launcher_text"
                    android:textColorHint="@color/launcher_text_dim"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 客户端协议版本 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_multiplayer_006"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_007"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/samp_version"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 服务器文字编码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_multiplayer_008"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_009"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/charset"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <!-- 隐藏的旧字段兼容占位 -->
            <RelativeLayout
                android:id="@+id/game_version_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/game_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </RelativeLayout>
        </LinearLayout>

        <!-- 卡片：连接与数据同步 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_multiplayer_010"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:text="@string/ui_settings_panel_multiplayer_011"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 快速连接 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_multiplayer_012"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_013"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/fastconnect_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 下载服务器自定义模型 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_multiplayer_014"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_015"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/dlmodels_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 保留本地数据包修改 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_multiplayer_016"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_017"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/modify_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片：0.3.DL 自定义模型缓存管理 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="theme_accent_text"
                        android:text="@string/ui_settings_panel_multiplayer_018"
                        android:textColor="@color/launcher_accent"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_dl_cache_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="@string/ui_settings_panel_multiplayer_019"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_8ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_multiplayer_020"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_dl_cache_import"
                    android:tag="theme_accent_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/launcher_btn_primary"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:text="@string/ui_settings_panel_multiplayer_021"
                    android:textColor="@color/launcher_on_accent"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_dl_cache_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="@string/refresh"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_dl_cache_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_24sdp"
                    android:background="@drawable/launcher_btn_danger"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="@string/ui_settings_panel_multiplayer_022"
                    android:textColor="@color/launcher_danger"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dl_cache_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/ui_item_bg"
                android:gravity="center"
                android:padding="@dimen/_8sdp"
                android:text="@string/ui_settings_panel_multiplayer_023"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_dl_cache_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 卡片：启动器主题配色 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="theme_accent_text"
                android:text="@string/ui_settings_panel_multiplayer_024"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/ui_settings_panel_multiplayer_025"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_theme_gold"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="@string/ui_settings_panel_multiplayer_026"
                    android:textColor="#FFAE1A"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_theme_cyan"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="@string/ui_settings_panel_multiplayer_027"
                    android:textColor="#18DCFF"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_theme_green"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="@string/ui_settings_panel_multiplayer_028"
                    android:textColor="#2ECC71"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_theme_red"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="@string/ui_settings_panel_multiplayer_029"
                    android:textColor="#FF4757"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_theme_purple"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="@string/ui_settings_panel_multiplayer_030"
                    android:textColor="#A55EEA"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_theme_blue"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="@string/ui_settings_panel_multiplayer_031"
                    android:textColor="#3788FF"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_settings_panel_multiplayer_032"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_theme_hue"
                    android:layout_width="@dimen/_140sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="1"
                    android:value="38"
                    android:valueFrom="0"
                    android:valueTo="360" />

                <TextView
                    android:id="@+id/tv_theme_hue_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="38°"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
