<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@drawable/ui_scroll_thumb"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- 卡片：镜头转动灵敏度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_camera_001"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/ui_settings_panel_camera_002"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 水平转向灵敏度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_4sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_003"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_004"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_cam_sens_x"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="5"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_cam_sens_x_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="50%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 垂直俯仰灵敏度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_005"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_006"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_cam_sens_y"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="5"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_cam_sens_y_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="50%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 步行镜头灵敏度倍率 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_007"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_008"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_cam_sens_foot"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="20"
                    android:valueTo="200" />

                <TextView
                    android:id="@+id/tv_cam_sens_foot_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="100%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 载具镜头灵敏度倍率 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_009"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_010"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_cam_sens_veh"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="20"
                    android:valueTo="200" />

                <TextView
                    android:id="@+id/tv_cam_sens_veh_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="100%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 开镜与瞄准灵敏度倍率 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_011"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_012"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_cam_sens_aim"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="20"
                    android:valueTo="200" />

                <TextView
                    android:id="@+id/tv_cam_sens_aim_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="70%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 反转垂直视角 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_013"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_014"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_invert_look"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片：视角机位与角色朝向 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_camera_015"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/ui_settings_panel_camera_016"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 自由镜头（不自动回正） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_017"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_018"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_free_cam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 第一人称视角查看 (MOB_FP) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_019"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_020"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_first_person_look"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 步战默认视角距离 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_021"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_022"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_ped_cam_zoom"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 载具默认视角高度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_023"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_024"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_veh_cam_height"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 角色头部朝向跟随 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_camera_025"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_camera_026"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/headmove_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
