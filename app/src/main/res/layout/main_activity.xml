<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:orientation="vertical">

    <!-- Classic Windows Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#F37021"
            android:gravity="center"
            android:text="S"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="San Andreas Multiplayer 0.3.7-R5-2-MP"
            android:textColor="#111111"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnWindowMinimize"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#333333"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnWindowMaximize"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="□"
            android:textColor="#333333"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnWindowClose"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#333333"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Classic Menu Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="#F0F0F0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/menuFile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:text="File"
            android:textColor="#111111"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:text="View"
            android:textColor="#111111"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuServers"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:text="Servers"
            android:textColor="#111111"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuTools"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:text="Tools"
            android:textColor="#111111"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuHelp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:text="Help"
            android:textColor="#111111"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D4D0C8" />

    <!-- Toolbar: Square Icon Buttons + Name Input + SA-MP Emblem -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#F0F0F0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <Button
            android:id="@+id/startButton"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:background="@drawable/win32_toolbar_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▶"
            android:textColor="#2E8B57"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddServer"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/win32_toolbar_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✔"
            android:textColor="#E67E22"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDeleteServer"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/win32_toolbar_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✖"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshServer"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/win32_toolbar_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="↻"
            android:textColor="#2980B9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="5dp"
            android:background="#ACA899" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:background="@drawable/win32_toolbar_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textColor="#333333"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Name:"
            android:textColor="#111111"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="156dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/win32_input_box"
            android:hint="Nickname"
            android:inputType="textNoSuggestions"
            android:maxLength="24"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:singleLine="true"
            android:text="Mobilador_PC"
            android:textColor="#111111"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- SA-MP Orange/Black Corner Emblem -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="#202020"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F37021"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="SA-MP"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0.3.7"
                android:textColor="#F37021"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Upper Split Content: Servers Table (Left) + Player/Score & Rule/Value (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F0F0"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Left Pane: Server Table -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.69"
            android:background="@drawable/win32_panel_sunken"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="#F0F0F0"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/win32_header_cell"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3.0"
                    android:background="@drawable/win32_header_cell"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:text="HostName"
                    android:textColor="#111111"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.95"
                    android:background="@drawable/win32_header_cell"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:text="Players"
                    android:textColor="#111111"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.65"
                    android:background="@drawable/win32_header_cell"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:text="Ping"
                    android:textColor="#111111"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.75"
                    android:background="@drawable/win32_header_cell"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:text="Mode"
                    android:textColor="#111111"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.35"
                    android:background="@drawable/win32_header_cell"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:text="Language"
                    android:textColor="#111111"
                    android:textSize="10sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvServers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:divider="@null"
                android:dividerHeight="0dp" />
        </LinearLayout>

        <!-- Right Pane: Player|Score + Rule|Value -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="0.31"
            android:orientation="vertical">

            <!-- Player | Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.54"
                android:background="@drawable/win32_panel_sunken"
                android:orientation="vertical"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="#F0F0F0"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.6"
                        android:background="@drawable/win32_header_cell"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:text="Player"
                        android:textColor="#111111"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/win32_header_cell"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:text="Score"
                        android:textColor="#111111"
                        android:textSize="10sp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lvPlayers"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
            </LinearLayout>

            <!-- Rule | Value -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="0.46"
                android:background="@drawable/win32_panel_sunken"
                android:orientation="vertical"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="#F0F0F0"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/win32_header_cell"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:text="Rule"
                        android:textColor="#111111"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:background="@drawable/win32_header_cell"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:text="Value"
                        android:textColor="#111111"
                        android:textSize="10sp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lvRules"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Lower Panel: Filter + Server Info + Black/Orange Ping Graph -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="#F0F0F0"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingBottom="2dp">

        <!-- Filter Group -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.30"
            android:background="@drawable/win32_group_box"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter"
                android:textColor="#111111"
                android:textSize="9.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode:"
                        android:textColor="#111111"
                        android:textSize="9sp" />

                    <EditText
                        android:id="@+id/etFilterMode"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:background="@drawable/win32_input_box"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:textColor="#111111"
                        android:textSize="9.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Language:"
                        android:textColor="#111111"
                        android:textSize="9sp" />

                    <EditText
                        android:id="@+id/etFilterLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:background="@drawable/win32_input_box"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:textColor="#111111"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbNotFull"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:buttonTint="#333333"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:scaleX="0.82"
                        android:scaleY="0.82"
                        android:text="Not Full"
                        android:textColor="#111111"
                        android:textSize="10sp" />

                    <CheckBox
                        android:id="@+id/cbNotEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:buttonTint="#333333"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:scaleX="0.82"
                        android:scaleY="0.82"
                        android:text="Not Empty"
                        android:textColor="#111111"
                        android:textSize="10sp" />

                    <CheckBox
                        android:id="@+id/cbNoPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:buttonTint="#333333"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:scaleX="0.82"
                        android:scaleY="0.82"
                        android:text="No Password"
                        android:textColor="#111111"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Server Info Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="0.38"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/tvServerInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Server Info: -"
                android:textColor="#111111"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServerInfo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:text="Address:
Players:
Ping:
Mode:
Language:"
                android:textColor="#111111"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Ping Graph Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.32"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:text="Ping"
                android:textColor="#111111"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="top|end"
                    android:text="400-"
                    android:textColor="#111111"
                    android:textSize="8.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical|end"
                    android:text="200-"
                    android:textColor="#111111"
                    android:textSize="8.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|end"
                    android:text="0-"
                    android:textColor="#111111"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <com.gta.launcher.ui.PingGraphView
                android:id="@+id/pingGraphView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Win32 Tabs: Favorites | Internet | Hosted -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#F0F0F0"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="6dp">

        <Button
            android:id="@+id/tabFavorites"
            android:layout_width="76dp"
            android:layout_height="20dp"
            android:background="@drawable/win32_tab_active"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Favorites"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/tabInternet"
            android:layout_width="76dp"
            android:layout_height="19dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/win32_tab_inactive"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Internet"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/tabHosted"
            android:layout_width="76dp"
            android:layout_height="19dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/win32_tab_inactive"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Hosted"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ACA899" />

    <!-- Bottom Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="#F0F0F0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/tvStatusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Servers: 0 players, playing on 0 servers."
            android:textColor="#111111"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvPermStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Storage: OK | 120 FPS"
            android:textColor="#1E5631"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
