<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/server_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_38sdp"
    android:layout_marginBottom="@dimen/_2sdp"
    android:background="@drawable/ui_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_10sdp"
    android:paddingEnd="@dimen/_10sdp">

    <View
        android:id="@+id/server_status"
        android:layout_width="@dimen/_5sdp"
        android:layout_height="@dimen/_5sdp"
        android:background="@drawable/ui_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/server_password"
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:src="@drawable/ic_locked"
                android:tint="@color/ui_warn"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/server_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_gamemode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_7ssp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/_52sdp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/server_players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/launcher_text"
            android:textSize="@dimen/_11ssp" />

        <ProgressBar
            android:id="@+id/server_players_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/_2sdp"
            android:max="100"
            android:progressDrawable="@drawable/ui_progress_mini" />
    </LinearLayout>

    <TextView
        android:id="@+id/server_ping"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/launcher_text"
        android:textSize="@dimen/_11ssp" />

</LinearLayout>
