<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@drawable/ui_scroll_thumb"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- 卡片：自定义触控按键位置 (Change Button Position) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="theme_accent_text"
                android:text="@string/ui_settings_panel_controls_001"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/ui_settings_panel_controls_002"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_open_hud_editor"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_primary"
                    android:gravity="center"
                    android:tag="theme_accent_bg"
                    android:text="@string/ui_settings_panel_controls_003"
                    android:textColor="@color/launcher_on_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_reset_hud_editor"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_28sdp"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="@string/ui_settings_panel_controls_004"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片：步战、摇杆与瞄准 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_controls_005"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/ui_settings_panel_controls_006"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 虚拟摇杆大小 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_4sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_007"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_008"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_joystick_size"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="50"
                    android:valueTo="150" />

                <TextView
                    android:id="@+id/tv_joystick_size_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="100%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 射击按键触发阈值 (MOB_BTH) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_009"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_010"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_shoot_threshold"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="5"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_shoot_threshold_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="50%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 自动攀爬障碍物 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_011"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_012"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_auto_climb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 武器瞄准方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_013"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_014"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_targeting_mode"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片：载具驾驶与触控方式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_settings_panel_controls_015"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/ui_settings_panel_controls_016"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 载具转向方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_017"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_018"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_touch_steering"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 触控按键布局 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_019"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_020"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_touch_layout"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 重力感应驾驶 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_021"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_022"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaOptionView
                    android:id="@+id/dropdown_accelerometer"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_26sdp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 摩托车摇杆转向 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_023"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_024"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_bike_steering"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 触控震动反馈 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_025"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_026"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_vibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 摇杆转向灵敏度 (MOB_ANA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_027"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_028"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_analog_sens"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="5"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_analog_sens_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="50%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@color/launcher_stroke" />

            <!-- 滑动转向灵敏度 (MOB_FLK) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_6sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_029"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_030"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <com.sampmobile.launcher.ui.widget.GtaSaSliderView
                    android:id="@+id/slider_flick_sens"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:stepSize="5"
                    android:valueFrom="5"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tv_flick_sens_val"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:tag="theme_accent_text"
                    android:text="50%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片：外接键鼠与手柄映射 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="theme_accent_text"
                android:text="@string/ui_settings_panel_controls_031"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/ui_settings_panel_controls_032"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />

            <!-- 启用键鼠快捷键映射 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_033"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_034"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_km_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 手柄右摇杆水平反转 (MOB_JIA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_035"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_036"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_joypad_invert_x"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/launcher_stroke" />

            <!-- 手柄右摇杆垂直反转 (MOB_JIB) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/_8sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_settings_panel_controls_037"
                        android:textColor="@color/launcher_text"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="@string/ui_settings_panel_controls_038"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_7ssp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_joypad_invert_y"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/bg_track" />
            </LinearLayout>

            <!-- 键鼠快捷键映射一览表 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/launcher_input_bg"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:padding="@dimen/_8sdp"
                android:text="@string/ui_settings_panel_controls_039"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_7ssp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
