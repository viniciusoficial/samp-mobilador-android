<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_4sdp"
    android:background="@drawable/ui_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_10sdp"
    android:paddingVertical="@dimen/_7sdp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                tools:text="HD_Roads_Pack" />

            <TextView
                android:id="@+id/tv_item_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/ui_pill"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_1sdp"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_6ssp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="64位"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_7ssp"
            tools:text="14 个文件 · 12.4 MB · 优先级 50" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_item_up"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:background="@drawable/launcher_btn_outline"
        android:contentDescription="@string/ui_item_mod_entry_001"
        android:foreground="?attr/selectableItemBackground"
        android:padding="@dimen/_4sdp"
        android:src="@drawable/ic_arrow_up"
        android:tint="@color/launcher_text"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btn_item_down"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginStart="@dimen/_3sdp"
        android:background="@drawable/launcher_btn_outline"
        android:contentDescription="@string/ui_item_mod_entry_002"
        android:foreground="?attr/selectableItemBackground"
        android:padding="@dimen/_4sdp"
        android:src="@drawable/ic_arrow_down"
        android:tint="@color/launcher_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_item_value"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginStart="@dimen/_6sdp"
        android:background="@drawable/launcher_btn_outline"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minWidth="@dimen/_40sdp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:textColor="@color/launcher_accent"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="1.0" />

    <Switch
        android:id="@+id/switch_item_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:thumb="@drawable/ic_thumb"
        android:track="@drawable/bg_track"
        tools:ignore="UseSwitchCompatOrMaterialXml,TouchTargetSizeCheck" />

    <ImageView
        android:id="@+id/btn_item_delete"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:background="@drawable/launcher_btn_danger"
        android:contentDescription="@string/ui_item_mod_entry_003"
        android:foreground="?attr/selectableItemBackground"
        android:padding="@dimen/_4sdp"
        android:src="@drawable/ic_delete"
        android:tint="@color/launcher_danger" />

</LinearLayout>
